#!/bin/bash
set -eu
umask 077

# The uninstall wizard supplies one of three explicit retention policies.
# Unknown/missing values fail safe by retaining only non-sensitive settings.
if [ -n "${TRIM_PKGVAR:-}" ] && [ "$TRIM_PKGVAR" != "/" ] && [ -d "$TRIM_PKGVAR" ]; then
  /var/apps/python312/target/bin/python3 "$(dirname "$0")/lifecycle.py" uninstall >> "$TRIM_TEMP_LOGFILE" 2>&1 || {
    echo "清理私有数据失败，请检查目录权限。共享目录与浏览器数据需另行清理。" >> "$TRIM_TEMP_LOGFILE"
    exit 1
  }
fi
