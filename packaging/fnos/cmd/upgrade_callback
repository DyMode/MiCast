#!/bin/bash
set -eu
umask 077
/var/apps/python312/target/bin/python3 "$(dirname "$0")/lifecycle.py" check-consent >> "$TRIM_TEMP_LOGFILE" 2>&1 || exit 1
mkdir -p "$TRIM_PKGVAR"
chmod 0700 "$TRIM_PKGVAR"
chown -R "$TRIM_USERNAME" "$TRIM_PKGVAR"
# var is persistent. Recover missing files without overwriting newer settings.
/var/apps/python312/target/bin/python3 "$(dirname "$0")/lifecycle.py" restore >> "$TRIM_TEMP_LOGFILE" 2>&1 || {
  echo "恢复升级前配置失败，已停止升级回调；请保留备份并检查目录权限。" >> "$TRIM_TEMP_LOGFILE"
  exit 1
}
chown -R "$TRIM_USERNAME" "$TRIM_PKGVAR"
runtime="${TRIM_APPDEST}/airplay2-runtime"
if [ -d "$runtime" ]; then
  chmod 0755 "$runtime/bin/nqptp" "$runtime/bin/shairport-sync" "$runtime/run-shairport"
  # The bundled musl loader matches the package architecture: the ARM FPK
  # ships an aarch64 runtime, the x86 FPK an x86-64 one.
  case "$(uname -m)" in
    aarch64|arm64) loader="$runtime/lib/ld-musl-aarch64.so.1" ;;
    *)             loader="$runtime/lib/ld-musl-x86_64.so.1" ;;
  esac
  # NQPTP needs cap_net_bind_service for the AirPlay 2 timing port. setcap can
  # be missing or refused on restricted systems — native AirPlay 2 then
  # degrades but the app itself runs, so warn visibly instead of aborting.
  if command -v setcap >/dev/null 2>&1 && [ -f "$loader" ]; then
    if ! setcap cap_net_bind_service=+ep "$loader" 2>>"$TRIM_TEMP_LOGFILE"; then
      {
        echo "警告：setcap 授权失败，原生 AirPlay 2（NQPTP 特权端口）可能不可用。"
      } >> "$TRIM_TEMP_LOGFILE" 2>&1
    fi
  else
    {
      echo "警告：缺少 setcap 或运行时加载器 $loader，无法启用原生 AirPlay 2 所需的 NQPTP 特权端口。"
    } >> "$TRIM_TEMP_LOGFILE" 2>&1
  fi
fi
rm -f "${TRIM_PKGVAR}/micast.pid" "${TRIM_APPDEST}/app.sock"
/var/apps/python312/target/bin/python3 "$(dirname "$0")/lifecycle.py" record-consent --source fnos-upgrade >> "$TRIM_TEMP_LOGFILE" 2>&1 || exit 1
chown "$TRIM_USERNAME" "${TRIM_PKGVAR}/legal-consent.json"
