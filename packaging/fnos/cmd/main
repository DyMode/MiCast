#!/bin/bash
set -u
umask 077

PID_FILE="${TRIM_PKGVAR}/micast.pid"
LOG_FILE="${TRIM_PKGVAR}/micast.log"
OLD_LOG_FILE="${TRIM_PKGVAR}/micast.log.1"
SOCKET_FILE="${TRIM_APPDEST}/app.sock"
LOCK_FILE="${TRIM_PKGVAR}/service.lock"
PYTHON_BIN="/var/apps/python312/target/bin/python3"
export PATH="/var/apps/python312/target/bin:$PATH"
PROCESS_HELPER="$(cd "$(dirname "$0")" && pwd)/service-process.py"
# Startup takes roughly ten seconds on a busy NAS. Both windows are deliberately
# generous: killing an instance that is still initializing was what turned a slow
# start into a restart loop, and every restart left another process behind.
STARTUP_GRACE_SECONDS="${MICAST_FNOS_STARTUP_GRACE:-25}"
LOCK_WAIT_SECONDS="${MICAST_FNOS_LOCK_WAIT:-90}"

service_pids() {
  "$PYTHON_BIN" "$PROCESS_HELPER" --username "$TRIM_USERNAME"
}

# Serialise start/stop so two "enable" clicks cannot each launch an instance.
# Without flock (unusual on fnOS) the script still works, just without the
# mutual exclusion.
acquire_lock() {
  command -v flock >/dev/null 2>&1 || return 0
  exec 9>"$LOCK_FILE" || return 1
  flock -w "$LOCK_WAIT_SECONDS" 9 || return 1
}

release_lock() {
  command -v flock >/dev/null 2>&1 || return 0
  flock -u 9 2>/dev/null || true
}

# Liveness for the startup grace window: the PID file written by the launch and
# the process scan are both best-effort (the scan spawns Python and can fail on
# a busy box), so either one claiming alive keeps the window open. Treating a
# single failed scan as "dead" resurrected the kill-a-starting-instance flap.
service_alive() {
  if [ -f "$PID_FILE" ]; then
    pid="$(cat "$PID_FILE" 2>/dev/null)"
    case "$pid" in
      ''|*[!0-9]*) ;;
      *) kill -0 "$pid" 2>/dev/null && return 0 ;;
    esac
  fi
  is_running
}

# Wait for /health, tolerating the window where runuser/nohup is still exec'ing.
# $1 = seconds, $2 = optional launcher PID to watch instead of the process scan.
wait_ready() {
  seconds="$1"
  watch_pid="${2:-}"
  deadline=$(( $(date +%s) + seconds ))
  while :; do
    if [ -S "$SOCKET_FILE" ] && is_healthy; then
      return 0
    fi
    if [ -n "$watch_pid" ]; then
      kill -0 "$watch_pid" 2>/dev/null || return 1
    else
      service_alive || return 1
    fi
    [ "$(date +%s)" -ge "$deadline" ] && return 1
    sleep 0.1
  done
}

is_running() {
  # /proc/<pid>/cwd can be unreadable after runuser changes identity, even
  # from a restricted root context. The service identity comes from its UID
  # and exact argv instead; scan also recovers children orphaned by old scripts.
  managed_pids="$(service_pids)" || return 1
  [ -n "$managed_pids" ]
}

rotate_log() {
  [ -f "$LOG_FILE" ] || return 0
  size="$(wc -c < "$LOG_FILE" 2>/dev/null || echo 0)"
  if [ "${size:-0}" -ge 5242880 ]; then
    rm -f "$OLD_LOG_FILE"
    mv "$LOG_FILE" "$OLD_LOG_FILE"
  fi
}

is_healthy() {
  # curl can speak to a unix socket directly; spawning a Python interpreter per
  # probe cost 0.3-0.6s each on the NAS and the loop probes repeatedly, which
  # showed up as a slow "enable" even though the app answered instantly.
  if command -v curl >/dev/null 2>&1; then
    curl -sf --max-time 2 --unix-socket "$SOCKET_FILE" http://localhost/health >/dev/null 2>&1
    return $?
  fi
  "$PYTHON_BIN" - "$SOCKET_FILE" <<'PY'
import socket
import sys

sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.settimeout(1)
try:
    sock.connect(sys.argv[1])
    sock.sendall(b"GET /health HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n")
    response = sock.recv(256)
except OSError:
    raise SystemExit(1) from None
finally:
    sock.close()
raise SystemExit(0 if b" 200 " in response else 1)
PY
}

stop_airplay2_runtime() {
  for pid_file in "${TRIM_PKGVAR}/shairport-sync.pid" "${TRIM_PKGVAR}/nqptp.pid"; do
    [ -f "$pid_file" ] || continue
    child_pid="$(cat "$pid_file" 2>/dev/null)"
    case "$child_pid" in
      ''|*[!0-9]*) rm -f "$pid_file"; continue ;;
    esac
    # A stale PID may have been reused. Only stop a process whose command line
    # still points inside this application's private AirPlay 2 runtime.
    if [ -r "/proc/$child_pid/cmdline" ] && tr '\0' ' ' < "/proc/$child_pid/cmdline" | grep -Fq "${TRIM_APPDEST}/airplay2-runtime"; then
      kill "$child_pid" 2>/dev/null || true
    fi
    rm -f "$pid_file"
  done
  # Recover from an interrupted stop. Scope the match to this app's private
  # runtime so no system AirPlay service is touched.
  for cmdline in /proc/[0-9]*/cmdline; do
    [ -r "$cmdline" ] || continue
    tr '\0' ' ' < "$cmdline" | grep -Fq "${TRIM_APPDEST}/airplay2-runtime" || continue
    child_pid="${cmdline#/proc/}"
    child_pid="${child_pid%/cmdline}"
    [ "$child_pid" = "$$" ] || kill "$child_pid" 2>/dev/null || true
  done
}

start_service() {
  if [ ! -f "$PROCESS_HELPER" ]; then
    echo "应用包缺少服务进程管理程序，请重新构建安装包。" > "$TRIM_TEMP_LOGFILE"
    return 1
  fi
  acquire_lock || {
    echo "等待其他启停操作完成超时，请稍后重试。" > "$TRIM_TEMP_LOGFILE"
    return 1
  }
  if is_running; then
    # An instance exists. It may simply still be initializing (startup takes
    # ~10s, and "enable" is often clicked while it runs), so give it the full
    # startup budget before concluding it is broken. Killing it here used to
    # turn every start into a kill/restart flap that left extra processes.
    if wait_ready "$STARTUP_GRACE_SECONDS"; then
      release_lock
      return 0
    fi
    # Final probe before giving up on it: the liveness scan can race.
    if is_healthy; then
      release_lock
      return 0
    fi
    stop_service_internal || { release_lock; return 1; }
  fi
  stop_airplay2_runtime
  rm -f "$PID_FILE" "$SOCKET_FILE"
  mkdir -p "$TRIM_PKGVAR"
  chown "$TRIM_USERNAME" "$TRIM_PKGVAR"
  export PYTHONPATH="${TRIM_APPDEST}/vendor:${TRIM_APPDEST}"
  export MICAST_DATA_DIR="$TRIM_PKGVAR"
  export MICAST_UNIX_SOCKET="$SOCKET_FILE"
  export MICAST_DEPLOYMENT="fnos"
  # Resolve the system-managed share without assuming a storage volume.
  shared="${TRIM_DATA_SHARE_PATHS:-}"
  shared="${shared%%:*}"
  unset MICAST_SHARED_DIR MICAST_LOG_DIR
  if [ -n "$shared" ] && [ -d "$shared" ] && \
      runuser -u "$TRIM_USERNAME" --preserve-environment -- \
      "$PYTHON_BIN" -m micast.fnos_storage "$shared"; then
    export MICAST_SHARED_DIR="$shared"
    export MICAST_LOG_DIR="$shared/logs"
  fi
  LOG_FILE="${MICAST_LOG_DIR:-$TRIM_PKGVAR}/micast.log"
  OLD_LOG_FILE="${LOG_FILE}.1"
  export PYTHON_BIN
  runtime="${TRIM_APPDEST}/airplay2-runtime"
  token_file="${TRIM_PKGVAR}/callback-token"
  if [ ! -s "$token_file" ]; then
    "$PYTHON_BIN" -c 'import secrets,sys; open(sys.argv[1], "w").write(secrets.token_urlsafe(32))' "$token_file"
    chown "$TRIM_USERNAME" "$token_file"
    chmod 0600 "$token_file"
  fi
  export MICAST_ORCHESTRATOR_TOKEN="$(cat "$token_file")"
  export MICAST_AIRPLAY_ENGINE="local"
  export MICAST_AIRPLAY_PROTOCOL="classic"
  if [ -x "${runtime}/bin/shairport-sync" ] && [ -x "${runtime}/bin/nqptp" ] && [ -x "${runtime}/run-shairport" ]; then
    export MICAST_AIRPLAY2_RUNTIME="$runtime"
    export MICAST_AIRPLAY2_MODE="single"
    export MICAST_AIRPLAY2_PCM_SOURCE="local:${runtime}/run-shairport"
  else
    export MICAST_AIRPLAY2_MODE="disabled"
    unset MICAST_AIRPLAY2_RUNTIME MICAST_AIRPLAY2_PCM_SOURCE
  fi
  export MICAST_DEVICE_ID="airplay2"
  export MICAST_AIRPLAY_NAME="MiCast"
  cd "$TRIM_APPDEST" || return 1
  rotate_log
  # setsid puts the service in its own session/process group so a teardown of
  # the caller's group (the app centre's per-request session) cannot take the
  # service down with it; that tear-down shows up as "Session terminated,
  # killing shell" and used to look like a random startup failure.
  if command -v setsid >/dev/null 2>&1; then
    setsid nohup runuser -u "$TRIM_USERNAME" --preserve-environment -- \
      "$PYTHON_BIN" -m micast >>"$LOG_FILE" 2>&1 &
  else
    nohup runuser -u "$TRIM_USERNAME" --preserve-environment -- \
      "$PYTHON_BIN" -m micast >>"$LOG_FILE" 2>&1 &
  fi
  # This PID comes from this launch, not a stale file. runuser/nohup may still
  # be exec'ing when the first probe runs, so strict cmdline/cwd matching is
  # only appropriate for status/stop, not for this startup liveness probe.
  launch_pid=$!
  echo "$launch_pid" > "$PID_FILE"
  startup_failure="等待服务就绪超时"
  if wait_ready "$STARTUP_GRACE_SECONDS" "$launch_pid"; then
    release_lock
    return 0
  fi
  kill -0 "$launch_pid" 2>/dev/null || startup_failure="启动进程提前退出"
  {
    echo "MiCast 启动失败：${startup_failure}。"
    echo "请稍后重试；如果仍无法启动，请在反馈时附上日志文件：${LOG_FILE}"
  } > "$TRIM_TEMP_LOGFILE"
  stop_service_internal
  release_lock
  return 1
}

# Caller holds the lock (start_service) or this wrapper takes it (stop).
stop_service_internal() {
  managed_pids="$(service_pids)" || return 1
  for pid in $managed_pids; do kill "$pid" 2>/dev/null || true; done
  for _ in $(seq 1 50); do
    is_running || break
    sleep 0.1
  done
  # Re-read identities before escalation; never trust an old PID file.
  managed_pids="$(service_pids)" || return 1
  for pid in $managed_pids; do kill -9 "$pid" 2>/dev/null || true; done
  stop_airplay2_runtime
  rm -f "$PID_FILE" "$SOCKET_FILE"
}

stop_service() {
  acquire_lock || return 1
  stop_service_internal
  status=$?
  release_lock
  return "$status"
}

case "${1:-}" in
  start) start_service ;;
  stop) stop_service ;;
  status) is_running && exit 0 || exit 3 ;;
  *) exit 1 ;;
esac
