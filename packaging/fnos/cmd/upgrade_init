#!/bin/bash
set -eu
umask 077
/var/apps/python312/target/bin/python3 "$(dirname "$0")/lifecycle.py" check-consent >> "$TRIM_TEMP_LOGFILE" 2>&1 || exit 1

mkdir -p "$TRIM_PKGVAR"
/var/apps/python312/target/bin/python3 "$(dirname "$0")/lifecycle.py" backup >> "$TRIM_TEMP_LOGFILE" 2>&1 || {
  echo "升级前备份 MiCast 配置失败，已停止升级。" >> "$TRIM_TEMP_LOGFILE"
  exit 1
}
